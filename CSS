body {
    font-family: Arial, sans-serif;
    text-align: center;
    background: #150016;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100vh;
    margin: 0;
}

#highScores {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.1);
    padding: 20px;
    border-radius: 10px;
    width: 300px;
    margin: 0 auto;
}

table {
    margin-top: 20px;
    border-collapse: collapse;
    width: 100%;
}

th, td {
    padding: 10px 15px;
    border: 1px solid #E386B1;
    text-align: center;
}

th {
    background-color: #E386B1;
    color: black;
}

tbody tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.05);
}

tbody tr:nth-child(odd) {
    background-color: rgba(255, 255, 255, 0.1);
}

